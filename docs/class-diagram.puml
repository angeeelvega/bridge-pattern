@startuml class-diagram
title Bridge pattern — class diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam dpi 130
skinparam ranksep 40
skinparam nodesep 20

package "Abstraction" {
  abstract class Notification <<Abstraction>> {
    - content : NotificationContent
    - channel : PresentationChannel
    + display() : Presentation
    + changeChannel(channel : PresentationChannel) : void
    + channel() : PresentationChannel
    + content() : NotificationContent
    + {abstract} type() : String
    # {abstract} prepare(content : NotificationContent) : PresentationRequest
  }

  class MessageNotification <<RefinedAbstraction>> {
    + {static} TYPE = "message"
    + type() : String
    # prepare(content : NotificationContent) : PresentationRequest
  }

  class AlertNotification <<RefinedAbstraction>> {
    + {static} TYPE = "alert"
    + type() : String
    # prepare(content : NotificationContent) : PresentationRequest
  }

  class WarningNotification <<RefinedAbstraction>> {
    + {static} TYPE = "warning"
    + type() : String
    # prepare(content : NotificationContent) : PresentationRequest
  }

  class ConfirmationNotification <<RefinedAbstraction>> {
    + {static} TYPE = "confirmation"
    + type() : String
    # prepare(content : NotificationContent) : PresentationRequest
  }

  MessageNotification -[hidden]down- AlertNotification
  AlertNotification -[hidden]down- WarningNotification
  WarningNotification -[hidden]down- ConfirmationNotification
}

package "Implementor" {
  abstract class PresentationChannel <<Implementor>> {
    + present(request : PresentationRequest) : Presentation
    + {abstract} name() : String
    # {abstract} formatFor(mode : InteractionMode) : String
    # adaptBody(body : String) : String
    # {abstract} render(...) : String
  }

  class DesktopChannel <<ConcreteImplementor>> {
    + {static} NAME = "desktop"
    + name() : String
    # formatFor(mode : InteractionMode) : String
    # render(...) : String
  }

  class MobileChannel <<ConcreteImplementor>> {
    + {static} NAME = "mobile"
    + {static} BODY_LIMIT = 80
    + name() : String
    # adaptBody(body : String) : String
    # formatFor(mode : InteractionMode) : String
    # render(...) : String
  }

  class WebChannel <<ConcreteImplementor>> {
    + {static} NAME = "web"
    + name() : String
    # formatFor(mode : InteractionMode) : String
    # render(...) : String
  }

  DesktopChannel -[hidden]down- MobileChannel
  MobileChannel -[hidden]down- WebChannel
}

package "Contract" {
  class NotificationContent <<record>> {
    + title : String
    + message : String
    + recipient : String
  }

  class PresentationRequest <<record>> {
    + type : String
    + urgency : UrgencyLevel
    + mode : InteractionMode
    + title : String
    + body : String
    + recipient : String
    + actions : List
  }

  class Presentation <<record>> {
    + channel : String
    + format : String
    + urgency : UrgencyLevel
    + mode : InteractionMode
    + visibleTitle : String
    + visibleBody : String
    + actions : List
    + rendered : String
  }

  enum UrgencyLevel {
    LOW
    MEDIUM
    HIGH
  }

  enum InteractionMode {
    INFORMATIVE
    PERSISTENT
    BLOCKING
  }

  NotificationContent -[hidden]right- PresentationRequest
  PresentationRequest -[hidden]right- Presentation
  UrgencyLevel -[hidden]right- InteractionMode
}

Notification <|-- MessageNotification
Notification <|-- AlertNotification
Notification <|-- WarningNotification
Notification <|-- ConfirmationNotification

PresentationChannel <|-- DesktopChannel
PresentationChannel <|-- MobileChannel
PresentationChannel <|-- WebChannel

Notification "*" o--> "1" PresentationChannel : bridge >
Notification "1" *--> "1" NotificationContent
Notification ..> PresentationRequest : prepares >
PresentationChannel ..> PresentationRequest : reads >
PresentationChannel ..> Presentation : returns >

PresentationRequest --> UrgencyLevel
PresentationRequest --> InteractionMode
Presentation --> UrgencyLevel
Presentation --> InteractionMode

Abstraction -[hidden]right- Implementor
Implementor -[hidden]down- Contract
@enduml
